# Base URL of the WeatherDashboard.Api backend.
VITE_API_BASE_URL=http://localhost:5299

# Leaflet raster tile URL template ({s}/{z}/{x}/{y}/{r}). The default is CARTO's free,
# keyless "Positron" light basemap; swap for a self-hosted tile server or a provider key
# (MapTiler, Stadia, Mapbox, etc.) in production.
VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
